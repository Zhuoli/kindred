# Server-side only. Never expose to the browser, never commit a real value.
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
# Optional
# KINDRED_CACHE_DIR=.cache          # local dev: cache Qloo responses in a gitignored folder
# KINDRED_QUOTA_RESERVE=1000        # stop fresh Qloo calls below this many remaining this month
# BLOB_READ_WRITE_TOKEN=            # set by `vercel blob create-store --access private`; enables the persistent cache
